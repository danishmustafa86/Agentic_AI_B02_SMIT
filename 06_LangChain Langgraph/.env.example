# ============================================================
# Environment Variables for Agentic AI 2026 Course
# ============================================================
# You can use free API keys from either Google AI Studio or Groq Console.
# If both are empty, the course scripts will automatically use the Mock LLM.

# Option 1: Free Google AI Studio API Key (https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# Option 2: Free Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: LangSmith Tracing & Observability (https://smith.langchain.com/)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=Agentic-AI-2026
